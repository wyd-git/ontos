# This file is deliberately safe only for the loopback-bound local environment.
# Every credential is public, disposable, and rejected when ONTOS_ENVIRONMENT=production.
ONTOS_ENVIRONMENT=local

ONTOS_POSTGRES_DB=ontos
ONTOS_POSTGRES_SUPERUSER=ontos_local_admin
ONTOS_POSTGRES_SUPERUSER_PASSWORD=local-only-postgres-admin-secret
ONTOS_DB_RUNTIME_USER=ontos_smoke_runtime
ONTOS_DB_RUNTIME_PASSWORD=local-only-postgres-runtime-secret

ONTOS_OIDC_REALM=ontos-local
ONTOS_OIDC_CLIENT_ID=ontos-smoke
ONTOS_OIDC_CLIENT_SECRET=local-only-oidc-client-secret
ONTOS_OIDC_ISSUER=http://127.0.0.1:18080/realms/ontos-local
ONTOS_OIDC_ADMIN_USERNAME=ontos-local-admin
ONTOS_OIDC_ADMIN_PASSWORD=local-only-keycloak-admin-secret

ONTOS_S3_ACCESS_KEY_ID=local-only-s3-access-key
ONTOS_S3_SECRET_ACCESS_KEY=local-only-s3-secret-key
ONTOS_S3_BUCKET=ontos-smoke
ONTOS_S3_ENDPOINT=http://127.0.0.1:18333
ONTOS_S3_REGION=us-east-1
ONTOS_S3_FORCE_PATH_STYLE=true
ONTOS_S3_MAX_ATTEMPTS=1
ONTOS_MANAGED_CSV_MAXIMUM_BYTES=536870912
