          "searchText": {
            "type": "string",
            "minLength": 0,
            "maxLength": 256
          },
          "where": {
            "$ref": "#/components/schemas/QueryPredicate"
          },
          "orderBy": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuerySort"
            },
            "maxItems": 1
          },
          "page": {
            "$ref": "#/components/schemas/LinkQueryPage"
          }
        },
        "required": ["schemaVersion", "direction", "select"]
      },
      "LinkQueryPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          },
          "cursor": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueCursor"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": []
      },
      "QueryPredicate": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/QueryComparisonPredicate"
          },
          {
            "$ref": "#/components/schemas/QueryNullPredicate"
          },
          {
            "$ref": "#/components/schemas/QueryAndPredicate"
          },
          {
            "$ref": "#/components/schemas/QueryOrPredicate"
          },
          {
            "$ref": "#/components/schemas/QueryNotPredicate"
          }
        ]
      },
      "QueryNotPredicate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "not": {
            "$ref": "#/components/schemas/QueryPredicate"
          }
        },
        "required": ["not"]
      },
      "QueryOrPredicate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "or": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueryPredicate"
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": ["or"]
      },
      "QueryAndPredicate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "and": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueryPredicate"
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": ["and"]
      },
      "QueryNullPredicate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "property": {
            "$ref": "#/components/schemas/ApiName"
          },
          "op": {
            "type": "string",
            "const": "isNull"
          }
        },
        "required": ["property", "op"]
      },
      "QueryComparisonPredicate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "property": {
            "$ref": "#/components/schemas/ApiName"
          },
          "op": {
            "type": "string",
            "enum": [
              "eq",
              "ne",
              "lt",
              "lte",
              "gt",
              "gte",
              "in",
              "contains",
              "prefix",
              "containsAny"
            ]
          },
          "value": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/QueryScalar"
              },
              {
                "$ref": "#/components/schemas/QueryScalarCollection"
              }
            ]
          }
        },
        "required": ["property", "op", "value"]
      },
      "QueryScalarCollection": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/QueryScalar"
        },
        "minItems": 1,
        "maxItems": 500,
        "uniqueItems": true
      },
      "QueryScalar": {
        "type": ["string", "number", "boolean"],
        "maxLength": 4096
      },
      "RuntimeLinkHop": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "linkTypeApiName": {
            "$ref": "#/components/schemas/ApiName"
          },
          "direction": {
            "type": "string",
            "enum": ["outgoing", "incoming"]
          }
        },
        "required": ["linkTypeApiName", "direction"]
      },
      "RuntimeCountRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "operation": {
            "type": "string",
            "const": "count"
          },
          "searchText": {
            "type": "string",
            "minLength": 0,
            "maxLength": 256
          },
          "where": {
            "$ref": "#/components/schemas/QueryPredicate"
          }
        },
        "required": ["schemaVersion", "operation"]
      },
      "RuntimeSearchRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "select": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiName"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "searchText": {
            "type": "string",
            "minLength": 0,
            "maxLength": 256
          },
          "where": {
            "$ref": "#/components/schemas/QueryPredicate"
          },
          "orderBy": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuerySort"
            },
            "maxItems": 1
          },
          "page": {
            "$ref": "#/components/schemas/QueryPage"
          }
        },
        "required": ["schemaVersion", "select"]
      },
      "QueryPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 50
          },
          "cursor": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueCursor"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": []
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "error"],
        "properties": {
          "schemaVersion": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorRecord"
          }
        }
      },
      "ErrorRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "category", "retryable", "details", "correlationId"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          },
          "category": {
            "type": "string",
            "enum": [
              "authentication",
              "authorization",
              "conflict",
              "dependency",
              "internal",
              "not_found",
              "rate_limit",
              "unavailable",
              "validation"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "$ref": "#/components/schemas/ErrorDetails"
          },
          "correlationId": {
            "$ref": "#/components/schemas/CorrelationId"
          }
        }
      },
      "ErrorDetails": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
